#!/usr/bin/env bash
set -euo pipefail
# Prints the plugin's absolute root. For the things a skill must READ rather than run --
# skills/foreman-init/templates/MANIFEST.tsv and .claude-plugin/plugin.json -- there is nothing
# to exec, so the root itself is the interface: `cat "$(foreman-root)/…"`.
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd
